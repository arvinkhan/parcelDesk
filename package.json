{
  "name": "parceldesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local dispatch, failed-delivery recovery, and cash settlement",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/setup.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/setup.ts seed",
    "db:provision": "tsx --env-file-if-exists=.env src/setup.ts provision",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts",
    "test:local": "node scripts/local-postgres.mjs test",
    "demo": "node scripts/local-postgres.mjs demo"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.7.0-beta.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
